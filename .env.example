# .env.example — the environment variables Travel & Expenses v2 reads.
# (The repo had no .env.example before this module; the rest of the app's
# variables are not listed here. Copy the ones you need to .env.local for
# development and to Vercel > Settings > Environment Variables for Production
# AND Preview.)

# ── required ────────────────────────────────────────────────────────────────
# The project URL. Already set for the rest of the app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key (Supabase > Project Settings > API). Server only: never
# prefix it with NEXT_PUBLIC_. Travel & Expenses refuses to run without it, and
# refuses the anon key in its place. After migration 151 nothing else can read
# the te_ tables.
SUPABASE_SERVICE_ROLE_KEY=
# Signs the ESS session token (lib/ess-session.ts). If unset the app falls back
# to SUPABASE_SERVICE_ROLE_KEY; set a separate random value of 32+ characters.
ESS_SESSION_SECRET=
# Protects /api/cron/te-daily. Vercel sends it by itself once it is set. Without
# it the nightly job answers 503 and does nothing.
CRON_SECRET=

# ── optional: road distances and address search ─────────────────────────────
# Server key with the Directions API and the Geocoding API enabled (the same
# variable the existing travel routes use). Without it the rules engine
# estimates road distance from the straight line, and a typed address needs a pin.
GOOGLE_MAPS_API_KEY=

# ── optional: outside providers that are not contracted yet ─────────────────
# Vehicle registration (RC) lookup. Leave unset: employees attach a photo of the
# RC and HR verifies it. "mock" answers five demo numbers and is refused on a
# production deployment. Any other value is a configuration error (503).
TE_RC_PROVIDER=
# Bill scanning (OCR). Leave unset: employees type the amount. Any value other
# than "none" is a configuration error until a provider is added in
# lib/te/providers/ocr.ts.
TE_OCR_PROVIDER=
